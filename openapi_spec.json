{
  "openapi": "3.1.0",
  "info": {
    "title": "Vancomycin steady-state PK and demonstration operations API",
    "version": "3.0.0",
    "description": "/api/pk models first-order one-compartment IV infusion steady-state exposure. Other audit endpoints are demonstration-only and not clinical decision support."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health status",
        "responses": {
          "200": {
            "description": "JSON service metadata"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "JSON process counters",
        "responses": {
          "200": {
            "description": "JSON counts, not Prometheus text"
          }
        }
      }
    },
    "/api/pk": {
      "post": {
        "summary": "Educational steady-state IV-infusion PK simulation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "dose_mg": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "interval_h": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "infusion_h": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "elimination_rate_h": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "volume_l": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "sample_after_infusion_h": {
                    "type": "number",
                    "minimum": 0,
                    "default": 0
                  }
                },
                "required": [
                  "dose_mg",
                  "interval_h",
                  "infusion_h",
                  "elimination_rate_h",
                  "volume_l"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Predicted CL, half-life, end-of-infusion peak, predose trough, sample concentration and AUC24"
          },
          "422": {
            "description": "Invalid or inconsistent inputs"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Demonstration-only supervisor task",
        "responses": {
          "200": {
            "description": "Demonstration dossier"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock chat response",
        "responses": {
          "200": {
            "description": "Mock response, not medical advice"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "In-memory signed audit entries",
        "responses": {
          "200": {
            "description": "Audit entries and HMAC verification state"
          }
        }
      }
    }
  }
}
